{
  "name": "javascript-mastery",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-questions.mjs && esbuild src/dom-worker.mjs --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/dom-worker.js && node network/build.mjs && node typescript/build.mjs --strict",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit-coverage.mjs",
    "audit:strict": "node scripts/audit-coverage.mjs --strict",
    "network:audit": "node network/build.mjs --strict",
    "network:smoke": "node scripts/network-smoke.mjs",
    "typescript:build": "node typescript/build.mjs",
    "typescript:audit": "node typescript/build.mjs --strict && node typescript/audit.mjs",
    "typescript:test": "node --test typescript/tests/*.test.mjs",
    "typescript:smoke": "node scripts/typescript-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "typescript": "6.0.3"
  }
}
